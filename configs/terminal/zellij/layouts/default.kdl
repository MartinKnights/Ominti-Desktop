// Ominty portable Zellij layout.
//
// Deliberately free of machine-specific commands and paths so it works on a
// fresh install. Put personal layouts in ~/.config/zellij/layouts/ under a
// different name, or edit this copy after the installer has deployed it.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Shell" focus=true {
        pane
    }
}
